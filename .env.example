# Copy to backend/.env (or export) and adjust. Every variable is optional: the defaults run
# fully locally with no API key (faster-whisper + llama.cpp) plus free edge-tts voices.

# --- provider selection ---------------------------------------------------
VOICEDESK_STT=whisper            # whisper | deepgram | fake
VOICEDESK_LLM=llamacpp           # llamacpp | openai_compat | scripted
VOICEDESK_TTS=edge               # edge | elevenlabs | fake

# --- local STT (faster-whisper) --------------------------------------------
VOICEDESK_WHISPER_MODEL=small    # tiny | base | small | medium | large-v3 (base is unusable for Arabic)
VOICEDESK_WHISPER_COMPUTE_TYPE=int8

# --- hosted streaming STT ---------------------------------------------------
VOICEDESK_DEEPGRAM_API_KEY=
VOICEDESK_DEEPGRAM_MODEL=nova-3
VOICEDESK_DEEPGRAM_LANGUAGE=multi   # "multi" does not cover Arabic; use "ar" for Arabic-only lines

# --- local LLM (llama-cpp-python, GGUF) -------------------------------------
VOICEDESK_LLAMACPP_MODEL_PATH=../.local/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
VOICEDESK_LLAMACPP_THREADS=

# --- any OpenAI-compatible endpoint -----------------------------------------
# Groq:   https://api.groq.com/openai/v1                          llama-3.3-70b-versatile
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.5-flash
# Ollama: http://localhost:11434/v1                               qwen2.5:7b
VOICEDESK_OPENAI_BASE_URL=https://api.groq.com/openai/v1
VOICEDESK_OPENAI_API_KEY=
VOICEDESK_OPENAI_MODEL=llama-3.3-70b-versatile

# --- hosted TTS --------------------------------------------------------------
VOICEDESK_ELEVENLABS_API_KEY=
VOICEDESK_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- turn taking ------------------------------------------------------------
VOICEDESK_VAD_END_SILENCE_MS=550   # endpointing window: lower = snappier, higher = fewer cut-offs
VOICEDESK_BARGE_IN_MIN_MS=180      # speech needed to interrupt the agent while it talks

# --- misc -------------------------------------------------------------------
VOICEDESK_CLINIC_TODAY=            # pin the clinic's clock (YYYY-MM-DD), e.g. for demos
VOICEDESK_METRICS_PATH=data/metrics.sqlite
VOICEDESK_CORS_ORIGINS=["http://localhost:3000"]
